{% comment %}
  CartRules — product page notice (F5 "warn customers early").
  Merchant adds this block to the product template from the theme editor.
  Reads the same `cartrules.rules_cache` shop metafield the checkout
  Function reads (see app/models/rules.server.js `syncRulesCache`) —
  requires the metafield definition to have storefront read access, which
  `ensureRulesCacheMetafieldDefinition` sets up.
{% endcomment %}

{% assign cache = shop.metafields.cartrules.rules_cache.value %}
{% assign rendered_notice = false %}
{% if cache and cache.enabled != false and cache.productNoticesEnabled != false %}
  {% assign product_gid_suffix = product.id | append: '' %}
  {% for rule in cache.rules %}
    {% if rule.ruleType == 'max_quantity' or rule.ruleType == 'no_discount' %}
      {% assign matches = false %}
      {% if rule.matchType == 'product_id' %}
        {% for pid in rule.productIds %}
          {% assign pid_suffix = pid | split: '/' | last %}
          {% if pid_suffix == product_gid_suffix %}
            {% assign matches = true %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if matches %}
        {% assign rendered_notice = true %}
        <div
          class="cartrules-notice"
          {% if rule.ruleType == 'max_quantity' %}data-cartrules-max="{{ rule.maxQuantity | escape }}"{% endif %}
          style="padding: 0.75rem 1rem; margin: 1rem 0; border-radius: 0.5rem; border: 1px solid rgba(var(--color-foreground, 18, 18, 18), 0.25);"
        >
          {% if rule.message != blank %}
            {{ rule.message | escape }}
          {% elsif rule.ruleType == 'max_quantity' %}
            Maximum {{ rule.maxQuantity }} per order for this item.
          {% else %}
            Discount codes can't be used on this item.
          {% endif %}
        </div>
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{% comment %}
  Theme editor only: a real, blank storefront must render nothing for a
  product with no matching rule (that's the correct/expected behavior, not
  a bug). But in the editor preview merchants need to SEE the block exists
  and is configured correctly even before any rule targets the product
  they're previewing — otherwise it looks broken/missing, which is what
  triggered the App Store review's "widget not visible" rejection.
{% endcomment %}
{% if request.design_mode and rendered_notice == false %}
  <div class="cartrules-notice cartrules-notice--placeholder" style="padding: 0.75rem 1rem; margin: 1rem 0; border-radius: 0.5rem; border: 1px dashed rgba(var(--color-foreground, 18, 18, 18), 0.35);">
    {% if cache %}
      No CartRules rule applies to this product right now. Add or edit a rule
      in the CartRules app to see the live notice here.
    {% else %}
      CartRules is installed but hasn't synced any rules yet. Create a rule
      in the CartRules app to activate this notice.
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Product rule notice",
  "target": "section",
  "settings": []
}
{% endschema %}
