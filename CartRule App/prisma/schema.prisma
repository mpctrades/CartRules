// OAuth sessions, plus (as of the dashboard/activity-log rework) a real
// event log. Rule DEFINITIONS still live in Shopify metaobjects/metafields
// (see README "Why no database?") — that hasn't changed. What changed: the
// dashboard KPIs, activity feed, and rule-activity chart need per-event
// history over time, which a single metafield JSON blob can't hold. Those
// live here instead, in RuleEvent.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  // Expiring offline tokens (future.expiringOfflineAccessTokens) — see
  // app/session-storage.server.js.
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per rule enforcement CartRules observed. Sources:
//  - "storefront": the theme blocks reported a shopper hitting a rule
//    (app/routes/proxy.events.jsx, via the app proxy) — no customer data;
//  - "test": a merchant ran the rule simulator (app/models/simulator.server.js);
//  - "order": the orders/create webhook (only once Protected Customer Data
//    access is approved — see app/utils/features.js).
model RuleEvent {
  id           String   @id @default(cuid())
  shop         String
  orderId      String   @default("")
  ruleId       String
  ruleTitle    String
  ruleType     String
  eventType    String   @default("") // e.g. "quantity_blocked", "discount_blocked", "rule_passed"
  source       String   @default("order")
  productId    String?
  productTitle String?
  attempted    Float?
  allowed      Float?
  cartKey      String? // hashed cart token: distinct protected carts, nothing identifying
  detail       String?
  createdAt    DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, ruleId])
}

// Per-shop bookkeeping for background jobs (app/scheduler.server.js).
model ShopState {
  shop               String    @id
  nextScheduleAt     DateTime? // next time a scheduled rule starts or ends
  lastWeeklySummary  DateTime?
  lastHealthCheck    DateTime?
  lastIssueKey       String? // issues already emailed, so each is sent once
  remindedRuleIds    String? // JSON: scheduled rules already reminded about
  updatedAt          DateTime  @updatedAt
}
